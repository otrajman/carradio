<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fallback: Car Radio without the CarPlay entitlement, for signing with a profile
	     that lacks com.apple.developer.carplay-communication (the CarPlay scene in
	     Info.plist simply never launches). Not used while the App ID has the capability;
	     select with CODE_SIGN_ENTITLEMENTS in testflight.yml if it is ever needed. -->
</dict>
</plist>
